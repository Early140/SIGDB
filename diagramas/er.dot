digraph ER {graph [rankdir=LR, bgcolor=white];node [shape=record,fontname="DejaVu Sans",fontsize=10,style=filled,fillcolor="#eaf2fa"];edge [color="#34658b",arrowsize=.7]; usuario[label="USUARIO|id_usuario PK|email UNIQUE|password_hash, rol"];entrenador[label="ENTRENADOR|id_entrenador PK|id_usuario FK"];categoria[label="CATEGORIA|id_categoria PK|nombre, rama, temporada"];jugador[label="JUGADOR|id_jugador PK|nombre, apellido, fecha_nacimiento"];jc[label="JUGADOR_CATEGORIA|id_jugador PK/FK|id_categoria PK/FK"];ec[label="ENTRENADOR_CATEGORIA|id_entrenador PK/FK|id_categoria PK/FK"];entrenamiento[label="ENTRENAMIENTO|id_entrenamiento PK|id_categoria FK|id_entrenador FK|fecha, turno"];asistencia[label="ASISTENCIA|id_asistencia PK|id_entrenamiento FK|id_jugador FK|estado"];entrenador->usuario[label="N:1"];jc->jugador[label="N:1"];jc->categoria[label="N:1"];ec->entrenador[label="N:1"];ec->categoria[label="N:1"];entrenamiento->ec[label="N:1"];asistencia->entrenamiento[label="N:1"];asistencia->jugador[label="N:1"];}
